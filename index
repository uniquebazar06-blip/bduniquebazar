        function openOrdersModal() {
            if (!currentUserMobile) {
                showToast("অর্ডার হিস্ট্রি দেখতে লগইন করুন", "info");
                openAuthModal();
                return;
            }
            setActiveBottomNav('navOrders');
            renderOrdersList();
            openModal('ordersModal');
        }

        function renderOrdersList() {
            const container = document.getElementById('ordersListContainer');
            if (userOrders.length === 0) {
                container.innerHTML = `<div class="empty-state"><i class="fas fa-box-open"></i>এখনো কোনো অর্ডার করা হয়নি।</div>`;
                return;
            }
            container.innerHTML = userOrders.map((o, idx) => {
                const itemsText = (o.items || []).map(i => `${escapeHtml(i.name)} (×${i.qty})`).join(', ');
                return `
                    <div class="order-card">
                        <div class="order-top">
                            <strong>#${escapeHtml(o.orderId)}</strong>
                            <span class="status-pill status-${escapeHtml(o.status || 'Pending')}">${escapeHtml(o.status || 'Pending')}</span>
                        </div>
                        <div style="font-size:13px; color:#475569; margin-bottom:6px;">${itemsText}</div>
                        <div style="font-size:12px; color:var(--muted); margin-bottom:8px;">
                            <i class="fas fa-location-dot"></i> ${escapeHtml(o.address)}<br>
                            <i class="fas fa-clock"></i> ${formatDate(o.createdAt)} | পেমেন্ট: ${escapeHtml(o.paymentMethod)}
                        </div>
                        <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px solid var(--border); padding-top:8px;">
                            <strong style="color:var(--primary); font-size:16px;">মোট: ৳ ${o.total}</strong>
                            <button class="btn btn-outline" style="padding:6px 12px; font-size:12px;" onclick="downloadOrderReceiptByIndex(${idx})">
                                <i class="fas fa-file-invoice"></i> রিসিট ডাউনলোড
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function downloadOrderReceiptByIndex(idx) {
            if (userOrders[idx]) generateAndShowReceipt(userOrders[idx]);
        }

        async function generateAndShowReceipt(order) {
            const area = document.getElementById('receiptRenderArea');
            const itemsRows = (order.items || []).map(item => `
                <tr><td>${escapeHtml(item.name)}</td><td>${item.qty}</td><td>৳${item.price * item.qty}</td></tr>
            `).join('');

            area.innerHTML = `
                <div class="receipt-box">
                    <div class="receipt-head">
                        <h2>BD UNIQUE BAZAR</h2>
                        <div style="font-size:12px; color:#475569;">অর্ডার ইনভয়েস / ক্যাশ মেমো</div>
                        <div style="font-size:12px; margin-top:4px;"><strong>অর্ডার আইডি:</strong> ${escapeHtml(order.orderId)} | <strong>তারিখ:</strong> ${formatDate(order.createdAt)}</div>
                    </div>
                    <div style="font-size:13px; line-height:1.5; margin-bottom:10px;">
                        <div><strong>ক্রেতার নাম:</strong> ${escapeHtml(order.customerName)}</div>
                        <div><strong>মোবাইল:</strong> ${escapeHtml(order.contactMobile || order.userMobile)}</div>
                        <div><strong>ঠিকানা:</strong> ${escapeHtml(order.address)}</div>
                        <div><strong>পেমেন্ট:</strong> ${escapeHtml(order.paymentMethod)} ${order.trxId ? `(TrxID: ${escapeHtml(order.trxId)})` : ''}</div>
                        <div><strong>স্ট্যাটাস:</strong> ${escapeHtml(order.status)}</div>
                    </div>
                    <table class="receipt-table">
                        <thead><tr><th>পণ্যের নাম</th><th>পরিমাণ</th><th>মূল্য</th></tr></thead>
                        <tbody>${itemsRows}</tbody>
                    </table>
                    <div class="receipt-totals">
                        <div style="display:flex; justify-content:space-between;"><span>সাবটোটাল:</span><span>৳${order.subtotal}</span></div>
                        <div style="display:flex; justify-content:space-between;"><span>ডেলিভারি চার্জ:</span><span>৳${order.deliveryCharge}</span></div>
                        <div style="display:flex; justify-content:space-between; font-weight:700; font-size:16px; color:#2563eb; margin-top:6px;">
                            <span>সর্বমোট:</span><span>৳${order.total}</span>
                        </div>
                    </div>
                    <div class="receipt-footer">BD UNIQUE BAZAR থেকে কেনাকাটার জন্য ধন্যবাদ!</div>
                </div>
            `;

            try {
                const canvas = await html2canvas(area, { scale: 2, backgroundColor: '#ffffff' });
                const imgData = canvas.toDataURL('image/jpeg', 0.95);
                document.getElementById('receiptPreviewImg').src = imgData;
                document.getElementById('receiptDownloadBtn').onclick = () => {
                    const link = document.createElement('a');
                    link.download = `BD_UNIQUE_BAZAR_${order.orderId}.jpg`;
                    link.href = imgData;
                    link.click();
                    showToast("রিসিট সেভ হচ্ছে!", "success");
                };
                openModal('receiptModal');
            } catch (e) {
                showToast("রিসিট তৈরি করতে সমস্যা হয়েছে", "error");
            }
        }

        // Direct Live Chat
        function openChatModal() {
            if (!currentUserMobile) {
                showToast("লাইভ চ্যাট করতে প্রথমে লগইন করুন", "info");
                openAuthModal();
                return;
            }
            setActiveBottomNav('navChat');
            openModal('chatModal');

            if (activeChatRef && activeChatHandler) activeChatRef.off('value', activeChatHandler);
            activeChatRef = db.ref(`chats/${currentUserMobile}/messages`);
            activeChatHandler = (snap) => {
                const box = document.getElementById('chatMessages');
                box.innerHTML = '';
                if (!snap.exists()) {
                    box.innerHTML = `<div class="msg-bubble msg-admin">আসসালামু আলাইকুম! BD UNIQUE BAZAR সাপোর্টে স্বাগতম। কীভাবে সাহায্য করতে পারি?</div>`;
                    return;
                }
                snap.forEach(child => {
                    const m = child.val();
                    const div = document.createElement('div');
                    div.className = `msg-bubble ${m.sender === 'customer' ? 'msg-customer' : 'msg-admin'}`;
                    div.innerHTML = `${escapeHtml(m.text)}<span class="msg-time">${formatDate(m.timestamp)}</span>`;
                    box.appendChild(div);
                });
                box.scrollTop = box.scrollHeight;
            };
            activeChatRef.on('value', activeChatHandler);
        }

        async function sendChatMessage() {
            const input = document.getElementById('chatInput');
            const text = input.value.trim();
            if (!text || !currentUserMobile) return;
            input.value = '';
            const now = Date.now();
            try {
                await db.ref(`chats/${currentUserMobile}/messages`).push({ sender: 'customer', text, timestamp: now });
                await db.ref(`chats/${currentUserMobile}/meta`).update({
                    customerMobile: currentUserMobile,
                    customerName: (currentUserProfile && currentUserProfile.name) || currentUserMobile,
                    lastMessage: text,
                    lastTime: now,
                    unreadAdmin: true
                });
            } catch (e) {
                showToast("মেসেজ পাঠানো যায়নি", "error");
            }
        }

        document.getElementById('chatInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendChatMessage();
        });

        // Real-Time In-App Notifications
        function getAllNotificationsList() {
            const combined = [];
            for (const [id, n] of Object.entries(globalNotifs)) {
                combined.push(Object.assign({ id, scope: 'global', isRead: seenGlobalNotifIds.includes(id) }, n));
            }
            for (const [id, n] of Object.entries(userNotifs)) {
                combined.push(Object.assign({ id, scope: 'user', isRead: Boolean(n.read) }, n));
            }
            return combined.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));
        }

        function updateNotificationBadge() {
            const unread = getAllNotificationsList().filter(n => !n.isRead).length;
            const badge = document.getElementById('notifBadge');
            badge.innerText = unread > 9 ? '9+' : unread;
            badge.style.display = unread > 0 ? 'flex' : 'none';
        }

        function openNotificationsModal() {
            const list = getAllNotificationsList();
            const container = document.getElementById('notifListContainer');
            if (list.length === 0) {
                container.innerHTML = `<div class="empty-state"><i class="fas fa-bell-slash"></i>কোনো নোটিফিকেশন নেই।</div>`;
            } else {
                container.innerHTML = list.map(n => `
                    <div class="notif-item ${n.isRead ? '' : 'unread'}">
                        <div class="notif-title">${n.scope === 'global' ? '📢 ' : '📦 '}${escapeHtml(n.title)}</div>
                        <div class="notif-msg">${escapeHtml(n.message)}</div>
                        <div class="notif-time">${formatDate(n.timestamp)}</div>
                    </div>
                `).join('');
            }
            openModal('notifModal');

            list.forEach(n => {
                if (!n.isRead) {
                    if (n.scope === 'global') seenGlobalNotifIds.push(n.id);
                    else if (currentUserMobile) db.ref(`notifications/users/${currentUserMobile}/${n.id}`).update({ read: true });
                }
            });
            localStorage.setItem('bdUniqueSeenNotifs', JSON.stringify(seenGlobalNotifIds));
            updateNotificationBadge();
        }

        initApp();
    </script>
</body>
</html>
