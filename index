<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <!-- WebView & GitHub Anti-Cache Meta Tags -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <title>BD UNIQUE BAZAR</title>

    <!-- Google Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <!-- html2canvas for Receipt/Invoice Image Download -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <!-- Firebase Compat SDK (Works on GitHub, Android WebView & Local file://) -->
    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>

    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --primary-soft: #eff6ff;
            --secondary: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --bg: #f1f5f9;
            --card: #ffffff;
            --text: #0f172a;
            --muted: #64748b;
            --border: #e2e8f0;
            --radius: 14px;
            --shadow-sm: 0 2px 10px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 8px 24px rgba(15, 23, 42, 0.09);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Hind Siliguri', sans-serif; -webkit-tap-highlight-color: transparent; }
        body { background-color: var(--bg); color: var(--text); overflow-x: hidden; padding-bottom: 82px; }
        button, input, select, textarea { font-family: inherit; }

        /* Dynamic Notice Bar */
        .notice-bar {
            background: linear-gradient(90deg, #1e3a8a, #2563eb);
            color: #fff;
            font-size: 13px;
            font-weight: 500;
            padding: 7px 14px;
            text-align: center;
            display: none;
        }

        /* Sticky Header / Navbar */
        .navbar {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 14px rgba(15, 23, 42, 0.06);
            position: sticky;
            top: 0;
            z-index: 120;
            padding: 10px 0 12px;
        }
        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .nav-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }
        .brand { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .brand img {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--primary);
            background: var(--primary-soft);
            box-shadow: 0 2px 8px rgba(37, 99, 235, 0.2);
        }
        .brand h1 {
            font-family: 'Poppins', 'Hind Siliguri', sans-serif;
            font-size: 18px;
            font-weight: 800;
            color: var(--text);
            letter-spacing: 0.6px;
            text-transform: uppercase;
            line-height: 1.1;
        }
        .brand h1 span { color: var(--primary); }

        .nav-icons { display: flex; align-items: center; gap: 10px; }
        .top-icon-btn {
            position: relative;
            background: #f8fafc;
            border: 1px solid var(--border);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text);
            font-size: 17px;
            cursor: pointer;
            transition: 0.2s;
        }
        .top-icon-btn:active { transform: scale(0.92); }
        .badge-count {
            position: absolute;
            top: -4px;
            right: -4px;
            background: var(--danger);
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            min-width: 18px;
            height: 18px;
            border-radius: 99px;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
            border: 2px solid #fff;
        }

        /* Search Bar */
        .search-wrapper {
            display: flex;
            width: 100%;
            background: #f1f5f9;
            border-radius: 30px;
            overflow: hidden;
            border: 1.5px solid var(--border);
            transition: border-color 0.2s;
        }
        .search-wrapper:focus-within { border-color: var(--primary); background: #fff; }
        .category-select {
            border: none;
            background: transparent;
            padding: 10px 10px 10px 14px;
            font-weight: 600;
            font-size: 13px;
            color: #334155;
            outline: none;
            border-right: 1px solid #cbd5e1;
            max-width: 128px;
            cursor: pointer;
        }
        .search-input {
            flex: 1;
            border: none;
            background: transparent;
            padding: 10px 12px;
            outline: none;
            font-size: 14px;
            min-width: 0;
            color: var(--text);
        }
        .search-btn {
            background: var(--primary);
            color: #fff;
            border: none;
            padding: 0 18px;
            cursor: pointer;
            font-size: 15px;
        }

        /* Main Container */
        .container { max-width: 1200px; margin: 14px auto; padding: 0 14px; }

        /* 5-SLIDE NEW PRODUCTS AUTO SLIDER */
        .slider-section { margin-bottom: 18px; position: relative; }
        .slider-viewport {
            position: relative;
            width: 100%;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: var(--shadow-md);
            background: #0f172a;
            aspect-ratio: 16 / 9;
            max-height: 300px;
        }
        @media (min-width: 768px) { .slider-viewport { max-height: 350px; } }
        .slider-track {
            display: flex;
            width: 100%;
            height: 100%;
            transition: transform 0.55s cubic-bezier(0.25, 0.8, 0.25, 1);
        }
        .slide-item { min-width: 100%; height: 100%; position: relative; cursor: pointer; overflow: hidden; }
        .slide-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
        .slide-item:hover img { transform: scale(1.03); }
        .slide-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(15, 23, 42, 0.9) 8%, rgba(15, 23, 42, 0.42) 52%, rgba(15, 23, 42, 0.1) 100%);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 18px 18px 34px;
            color: #fff;
        }
        .slide-top-badges {
            position: absolute;
            top: 12px;
            left: 12px;
            right: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .slide-new-pill {
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .slide-disc-pill { background: var(--danger); color: #fff; font-size: 11px; font-weight: 700; padding: 4px 9px; border-radius: 20px; }
        .slide-cat { font-size: 12px; color: #93c5fd; font-weight: 600; margin-bottom: 2px; }
        .slide-title {
            font-size: 19px;
            font-weight: 700;
            line-height: 1.25;
            margin-bottom: 6px;
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        @media (min-width: 640px) { .slide-title { font-size: 24px; } }
        .slide-bottom-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
        .slide-prices { display: flex; align-items: baseline; gap: 8px; }
        .slide-price { font-size: 20px; font-weight: 800; color: #38bdf8; }
        .slide-old-price { font-size: 13px; color: #cbd5e1; text-decoration: line-through; }
        .slide-cta {
            background: rgba(255, 255, 255, 0.95);
            color: var(--primary-dark);
            padding: 6px 13px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .slider-nav-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: none;
            background: rgba(255, 255, 255, 0.24);
            backdrop-filter: blur(6px);
            color: #fff;
            font-size: 13px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 5;
        }
        .slider-prev { left: 10px; }
        .slider-next { right: 10px; }
        .slider-dots {
            position: absolute;
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 6px;
            z-index: 5;
        }
        .slider-dot {
            width: 8px;
            height: 8px;
            border-radius: 99px;
            background: rgba(255, 255, 255, 0.45);
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .slider-dot.active { width: 24px; background: #fff; }

        /* Dynamic Category Pills */
        .category-pills {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding: 2px 0 10px;
            margin-bottom: 12px;
            scrollbar-width: none;
        }
        .category-pills::-webkit-scrollbar { display: none; }
        .cat-pill {
            white-space: nowrap;
            background: var(--card);
            border: 1px solid var(--border);
            padding: 8px 15px;
            border-radius: 25px;
            font-size: 13px;
            font-weight: 600;
            color: #475569;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: 0.2s;
        }
        .cat-pill.active {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.28);
        }

        /* Section Header */
        .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .section-title { font-size: 18px; font-weight: 700; border-left: 4px solid var(--primary); padding-left: 10px; }
        .clear-filter-btn {
            font-size: 13px;
            color: var(--primary);
            background: var(--primary-soft);
            border: none;
            padding: 4px 10px;
            border-radius: 16px;
            font-weight: 600;
            cursor: pointer;
            display: none;
        }

        /* Product Grid */
        .product-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
        @media (min-width: 640px) {
            .product-grid { grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 16px; }
            .brand h1 { font-size: 22px; }
        }
        .product-card {
            background: var(--card);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            cursor: pointer;
            position: relative;
            display: flex;
            flex-direction: column;
            transition: transform 0.2s, box-shadow 0.2s;
            border: 1px solid #eef2f7;
        }
        .product-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
        .product-card:active { transform: scale(0.98); }
        .product-img-wrap { position: relative; width: 100%; height: 160px; background: #e2e8f0; overflow: hidden; }
        .product-img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .discount-badge {
            position: absolute;
            top: 8px;
            left: 8px;
            background: var(--danger);
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 6px;
        }
        .stock-out-badge {
            position: absolute;
            inset: 0;
            background: rgba(15, 23, 42, 0.58);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
        }
        .card-fav-indicator {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: rgba(255,255,255,0.92);
            color: #cbd5e1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.12);
        }
        .card-fav-indicator.active { color: var(--danger); }

        .product-info { padding: 10px 11px 12px; flex: 1; display: flex; flex-direction: column; gap: 4px; }
        .product-cat-label { font-size: 11px; color: var(--muted); font-weight: 600; }
        .product-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--text);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.32;
        }
        .card-rating { font-size: 12px; color: var(--warning); display: flex; align-items: center; gap: 4px; }
        .card-rating span { color: var(--muted); font-size: 11px; }
        .price-row { margin-top: auto; display: flex; align-items: baseline; gap: 6px; padding-top: 4px; }
        .product-price { font-size: 17px; font-weight: 700; color: var(--primary); }
        .product-old-price { font-size: 12px; color: #94a3b8; text-decoration: line-through; }

        /* Bottom Navigation Bar */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(255, 255, 255, 0.97);
            backdrop-filter: blur(10px);
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-around;
            padding: 7px 4px 9px;
            z-index: 150;
            box-shadow: 0 -4px 14px rgba(15, 23, 42, 0.06);
        }
        .bnav-item {
            background: none;
            border: none;
            color: var(--muted);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            position: relative;
            min-width: 58px;
        }
        .bnav-item i { font-size: 19px; }
        .bnav-item.active { color: var(--primary); }
        .bnav-badge {
            position: absolute;
            top: -4px;
            right: 8px;
            background: var(--danger);
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            min-width: 17px;
            height: 17px;
            border-radius: 99px;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
            border: 1.5px solid #fff;
        }

        /* Modal System */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.58);
            backdrop-filter: blur(4px);
            display: none;
            justify-content: center;
            align-items: flex-end;
            z-index: 1000;
        }
        @media (min-width: 640px) { .modal-overlay { align-items: center; padding: 20px; } }
        .modal-sheet {
            background: #fff;
            width: 100%;
            max-width: 620px;
            max-height: 92vh;
            border-radius: 20px 20px 0 0;
            overflow-y: auto;
            position: relative;
            animation: slideUp 0.22s ease;
        }
        @media (min-width: 640px) { .modal-sheet { border-radius: 18px; } }
        @keyframes slideUp { from { transform: translateY(32px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .modal-header {
            position: sticky;
            top: 0;
            background: #fff;
            padding: 14px 18px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 10;
        }
        .modal-header h3 { font-size: 17px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
        .close-btn {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: none;
            background: #f1f5f9;
            color: #475569;
            font-size: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .modal-body { padding: 16px 18px 24px; }

        /* Product Details Modal */
        .details-hero { position: relative; width: 100%; height: 270px; background: #f1f5f9; }
        .details-hero img { width: 100%; height: 100%; object-fit: cover; }
        .details-top-actions {
            position: absolute;
            top: 12px;
            left: 12px;
            right: 12px;
            display: flex;
            justify-content: space-between;
        }
        .circle-overlay-btn {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: none;
            background: rgba(15,23,42,0.6);
            color: #fff;
            font-size: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .d-title { font-size: 20px; font-weight: 700; margin-bottom: 6px; }
        .d-price-wrap { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
        .d-price { font-size: 24px; font-weight: 800; color: var(--primary); }
        .d-old-price { font-size: 15px; color: #94a3b8; text-decoration: line-through; }
        .d-stock { font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 20px; background: #dcfce7; color: #166534; }
        .d-stock.out { background: #fee2e2; color: #991b1b; }
        .d-desc { font-size: 14px; color: #475569; line-height: 1.65; margin-bottom: 16px; white-space: pre-line; }

        .details-action-bar { display: grid; grid-template-columns: 1fr 1fr auto auto; gap: 8px; margin-bottom: 20px; }
        .btn {
            border: none;
            border-radius: 10px;
            padding: 11px 14px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: 0.2s;
        }
        .btn:disabled { opacity: 0.55; cursor: not-allowed; }
        .btn:active:not(:disabled) { transform: scale(0.97); }
        .btn-primary { background: var(--primary); color: #fff; }
        .btn-success { background: var(--secondary); color: #fff; }
        .btn-danger { background: var(--danger); color: #fff; }
        .btn-outline { background: #f8fafc; color: var(--text); border: 1px solid var(--border); }
        .btn-icon-sq { width: 44px; padding: 0; font-size: 17px; }
        .btn-fav.active { background: #fef2f2; color: var(--danger); border-color: var(--danger); }

        /* Reviews Section */
        .sub-section { border-top: 1px solid var(--border); padding-top: 16px; margin-top: 16px; }
        .sub-title { font-size: 16px; font-weight: 700; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
        .star-picker { display: flex; gap: 6px; font-size: 24px; color: #cbd5e1; margin-bottom: 8px; cursor: pointer; }
        .star-picker i.active { color: var(--warning); }
        .review-form { background: #f8fafc; padding: 12px; border-radius: 12px; margin-bottom: 12px; border: 1px solid var(--border); }
        .review-card { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; }
        .review-head { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px; }
        .review-stars { color: var(--warning); font-size: 12px; }
        .review-text { font-size: 13px; color: #475569; }

        /* Related Products */
        .related-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
        @media (min-width: 500px) { .related-grid { grid-template-columns: repeat(4, 1fr); } }
        .related-card { border: 1px solid var(--border); border-radius: 10px; overflow: hidden; cursor: pointer; background: #fff; }
        .related-card img { width: 100%; height: 95px; object-fit: cover; display: block; }
        .related-card-info { padding: 7px; }
        .related-card-title { font-size: 12px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .related-card-price { font-size: 13px; font-weight: 700; color: var(--primary); }

        /* Forms */
        .form-group { margin-bottom: 12px; }
        .form-group label { display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 4px; }
        .form-control {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            font-size: 14px;
            outline: none;
            background: #fff;
        }
        .form-control:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12); }
        .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .toggle-auth { text-align: center; margin-top: 14px; font-size: 14px; color: var(--muted); cursor: pointer; }
        .toggle-auth span:last-child { color: var(--primary); font-weight: 700; }

        /* Cart & Checkout */
        .cart-item { display: flex; gap: 10px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border); }
        .cart-item img { width: 58px; height: 58px; border-radius: 8px; object-fit: cover; }
        .cart-item-info { flex: 1; min-width: 0; }
        .cart-item-title { font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .cart-item-price { font-size: 13px; color: var(--primary); font-weight: 700; }
        .qty-ctrl { display: flex; align-items: center; gap: 8px; }
        .qty-btn { width: 28px; height: 28px; border-radius: 7px; border: 1px solid var(--border); background: #f8fafc; font-weight: 700; cursor: pointer; }
        .summary-box { background: #f8fafc; border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; margin: 14px 0; font-size: 14px; }
        .summary-row { display: flex; justify-content: space-between; margin-bottom: 6px; }
        .summary-total { border-top: 1px dashed #cbd5e1; padding-top: 8px; font-weight: 700; font-size: 16px; color: var(--primary); margin-bottom: 0; }

        .payment-options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 10px; }
        .pay-opt { border: 2px solid var(--border); border-radius: 10px; padding: 10px 6px; text-align: center; font-size: 13px; font-weight: 700; cursor: pointer; }
        .pay-opt.active { border-color: var(--primary); background: var(--primary-soft); color: var(--primary); }
        .pay-instruction {
            background: #fff7ed;
            border: 1px solid #fed7aa;
            border-radius: 10px;
            padding: 10px 12px;
            font-size: 13px;
            margin-bottom: 10px;
            display: none;
            line-height: 1.5;
        }
        .copy-num-btn { background: var(--primary); color: #fff; border: none; border-radius: 6px; padding: 2px 8px; font-size: 12px; font-weight: 600; margin-left: 6px; cursor: pointer; }

        /* Orders List */
        .order-card { border: 1px solid var(--border); border-radius: 12px; padding: 12px; margin-bottom: 12px; background: #fff; }
        .order-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
        .status-pill { font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 20px; }
        .status-Pending { background: #fef3c7; color: #92400e; }
        .status-Confirmed { background: #dbeafe; color: #1e40af; }
        .status-Shipped { background: #e0e7ff; color: #3730a3; }
        .status-Delivered { background: #dcfce7; color: #166534; }
        .status-Cancelled { background: #fee2e2; color: #991b1b; }

        /* Live Chat UI */
        .chat-container { display: flex; flex-direction: column; height: 68vh; }
        .chat-messages { flex: 1; overflow-y: auto; padding: 12px; background: #f8fafc; display: flex; flex-direction: column; gap: 8px; }
        .msg-bubble { max-width: 80%; padding: 9px 13px; border-radius: 14px; font-size: 14px; line-height: 1.45; word-break: break-word; }
        .msg-customer { align-self: flex-end; background: var(--primary); color: #fff; border-bottom-right-radius: 4px; }
        .msg-admin { align-self: flex-start; background: #fff; color: var(--text); border: 1px solid var(--border); border-bottom-left-radius: 4px; }
        .msg-time { font-size: 10px; opacity: 0.72; margin-top: 3px; display: block; text-align: right; }
        .chat-input-bar { display: flex; gap: 8px; padding: 10px 14px; border-top: 1px solid var(--border); background: #fff; }

        /* Notifications */
        .notif-item { padding: 11px 12px; border-radius: 10px; border: 1px solid var(--border); margin-bottom: 8px; background: #fff; }
        .notif-item.unread { background: var(--primary-soft); border-color: #bfdbfe; }
        .notif-title { font-size: 14px; font-weight: 700; margin-bottom: 2px; }
        .notif-msg { font-size: 13px; color: #475569; }
        .notif-time { font-size: 11px; color: #94a3b8; margin-top: 4px; }

        /* Off-screen Receipt Render Area */
        #receiptRenderArea {
            position: fixed;
            left: -9999px;
            top: 0;
            width: 420px;
            background: #ffffff;
            color: #1e293b;
            padding: 24px;
            font-family: 'Hind Siliguri', sans-serif;
        }
        .receipt-box { border: 2px solid #1e293b; border-radius: 10px; padding: 18px; }
        .receipt-head { text-align: center; border-bottom: 2px dashed #cbd5e1; padding-bottom: 12px; margin-bottom: 12px; }
        .receipt-head h2 { font-size: 20px; color: #2563eb; text-transform: uppercase; letter-spacing: 0.5px; }
        .receipt-table { width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 13px; }
        .receipt-table th, .receipt-table td { border-bottom: 1px solid #e2e8f0; padding: 6px 4px; text-align: left; }
        .receipt-table th:last-child, .receipt-table td:last-child { text-align: right; }
        .receipt-totals { border-top: 2px dashed #cbd5e1; padding-top: 10px; font-size: 14px; }
        .receipt-footer { text-align: center; font-size: 12px; color: #64748b; margin-top: 14px; }

        /* Toast & Confirm */
        .toast-container {
            position: fixed;
            top: 16px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 3000;
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 90%;
            max-width: 380px;
            pointer-events: none;
        }
        .toast {
            background: #1e293b;
            color: #fff;
            padding: 11px 16px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            box-shadow: 0 8px 20px rgba(0,0,0,0.22);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .toast.success { background: #059669; }
        .toast.error { background: #dc2626; }

        .confirm-box { background: #fff; width: 90%; max-width: 360px; border-radius: 16px; padding: 20px; text-align: center; margin: auto; }
        .empty-state { grid-column: 1 / -1; text-align: center; padding: 45px 15px; color: var(--muted); }
        .empty-state i { font-size: 36px; margin-bottom: 10px; color: #cbd5e1; display: block; }
    </style>
</head>
