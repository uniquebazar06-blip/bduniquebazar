        // 5-Slide Auto-Moving New Products Slider
        function renderNewProductsSlider() {
            const section = document.getElementById('newProductSliderSection');
            const track = document.getElementById('sliderTrack');
            const dotsEl = document.getElementById('sliderDots');

            sliderItems = Object.entries(productsData)
                .sort((a, b) => (b[1].createdAt || 0) - (a[1].createdAt || 0))
                .slice(0, 5);

            if (sliderItems.length === 0) {
                section.style.display = 'none';
                stopSliderAutoPlay();
                return;
            }

            section.style.display = 'block';
            currentSlideIndex = 0;

            track.innerHTML = sliderItems.map(([id, p]) => {
                const hasDiscount = p.oldPrice && Number(p.oldPrice) > Number(p.price);
                const discPct = hasDiscount ? Math.round(((p.oldPrice - p.price) / p.oldPrice) * 100) : 0;
                return `
                    <div class="slide-item" onclick="openProductDetails('${id}')">
                        <img src="${escapeHtml(p.image)}" alt="${escapeHtml(p.name)}" onerror="this.src='https://via.placeholder.com/800x450?text=BD+UNIQUE+BAZAR'">
                        <div class="slide-overlay">
                            <div class="slide-top-badges">
                                <span class="slide-new-pill"><i class="fas fa-bolt"></i> নতুন পণ্য</span>
                                ${hasDiscount ? `<span class="slide-disc-pill">-${discPct}% ছাড়</span>` : ''}
                            </div>
                            <div class="slide-cat">${escapeHtml(getCategoryName(p.category))}</div>
                            <div class="slide-title">${escapeHtml(p.name)}</div>
                            <div class="slide-bottom-row">
                                <div class="slide-prices">
                                    <span class="slide-price">৳ ${p.price}</span>
                                    ${hasDiscount ? `<span class="slide-old-price">৳ ${p.oldPrice}</span>` : ''}
                                </div>
                                <span class="slide-cta">বিস্তারিত <i class="fas fa-arrow-right"></i></span>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            dotsEl.innerHTML = sliderItems.map((_, idx) => `
                <button class="slider-dot ${idx === 0 ? 'active' : ''}" data-idx="${idx}" aria-label="Slide ${idx + 1}"></button>
            `).join('');

            dotsEl.querySelectorAll('.slider-dot').forEach(dot => {
                dot.addEventListener('click', (e) => {
                    e.stopPropagation();
                    goToSlide(Number(dot.dataset.idx));
                    startSliderAutoPlay();
                });
            });

            updateSliderPosition();
            startSliderAutoPlay();
        }

        function updateSliderPosition() {
            document.getElementById('sliderTrack').style.transform = `translateX(-${currentSlideIndex * 100}%)`;
            document.querySelectorAll('#sliderDots .slider-dot').forEach((dot, idx) => {
                dot.classList.toggle('active', idx === currentSlideIndex);
            });
        }

        function goToSlide(idx) {
            if (sliderItems.length === 0) return;
            currentSlideIndex = (idx + sliderItems.length) % sliderItems.length;
            updateSliderPosition();
        }

        function stopSliderAutoPlay() {
            if (sliderTimer) { clearInterval(sliderTimer); sliderTimer = null; }
        }

        function startSliderAutoPlay() {
            stopSliderAutoPlay();
            if (sliderItems.length <= 1) return;
            sliderTimer = setInterval(() => goToSlide(currentSlideIndex + 1), 3500);
        }

        function setupSliderControls() {
            document.getElementById('sliderPrevBtn').addEventListener('click', (e) => {
                e.stopPropagation(); goToSlide(currentSlideIndex - 1); startSliderAutoPlay();
            });
            document.getElementById('sliderNextBtn').addEventListener('click', (e) => {
                e.stopPropagation(); goToSlide(currentSlideIndex + 1); startSliderAutoPlay();
            });
            const viewport = document.getElementById('sliderViewport');
            viewport.addEventListener('touchstart', (e) => {
                touchStartX = e.changedTouches[0].screenX; stopSliderAutoPlay();
            }, { passive: true });
            viewport.addEventListener('touchend', (e) => {
                const diff = e.changedTouches[0].screenX - touchStartX;
                if (Math.abs(diff) > 40) {
                    if (diff < 0) goToSlide(currentSlideIndex + 1);
                    else goToSlide(currentSlideIndex - 1);
                }
                startSliderAutoPlay();
            }, { passive: true });
        }

        // Products Rendering & Filtering
        function getProductRatingStats(prodId) {
            const pRevs = reviewsData[prodId];
            if (!pRevs) return { avg: 0, count: 0 };
            const list = Object.values(pRevs);
            const sum = list.reduce((acc, r) => acc + Number(r.rating || 0), 0);
            return { avg: list.length ? (sum / list.length).toFixed(1) : 0, count: list.length };
        }

        function getCategoryName(catId) {
            const c = categoriesData[catId];
            if (!c) return catId || 'অন্যান্য';
            return typeof c === 'string' ? c : (c.name || catId);
        }

        function renderProducts() {
            const grid = document.getElementById('productGrid');
            const search = document.getElementById('searchInput').value.trim().toLowerCase();
            const cat = selectedCategory;
            const titleEl = document.getElementById('sectionTitle');
            const clearBtn = document.getElementById('clearFilterBtn');

            if (viewingFavoritesOnly) {
                titleEl.innerText = "আপনার ফেভারিট পণ্য";
                clearBtn.style.display = 'inline-block';
            } else if (cat !== 'all') {
                titleEl.innerText = getCategoryName(cat);
                clearBtn.style.display = 'inline-block';
            } else {
                titleEl.innerText = "সব পণ্যসমূহ";
                clearBtn.style.display = search ? 'inline-block' : 'none';
            }

            grid.innerHTML = '';
            const entries = Object.entries(productsData).sort((a, b) => (b[1].createdAt || 0) - (a[1].createdAt || 0));
            let count = 0;

            for (const [id, p] of entries) {
                const matchSearch = !search || (p.name || '').toLowerCase().includes(search) || getCategoryName(p.category).toLowerCase().includes(search);
                const matchCat = cat === 'all' || p.category === cat;
                const matchFav = !viewingFavoritesOnly || Boolean(userFavorites[id]);

                if (matchSearch && matchCat && matchFav) {
                    count++;
                    const stats = getProductRatingStats(id);
                    const hasDiscount = p.oldPrice && Number(p.oldPrice) > Number(p.price);
                    const discountPct = hasDiscount ? Math.round(((p.oldPrice - p.price) / p.oldPrice) * 100) : 0;
                    const outOfStock = p.stock !== undefined && Number(p.stock) <= 0;
                    const isFav = Boolean(userFavorites[id]);

                    const card = document.createElement('div');
                    card.className = 'product-card';
                    card.onclick = () => openProductDetails(id);

                    card.innerHTML = `
                        <div class="product-img-wrap">
                            <img src="${escapeHtml(p.image)}" class="product-img" alt="${escapeHtml(p.name)}" onerror="this.src='https://via.placeholder.com/300?text=No+Image'">
                            ${hasDiscount ? `<span class="discount-badge">-${discountPct}%</span>` : ''}
                            <div class="card-fav-indicator ${isFav ? 'active' : ''}"><i class="fas fa-heart"></i></div>
                            ${outOfStock ? `<div class="stock-out-badge">স্টক আউট</div>` : ''}
                        </div>
                        <div class="product-info">
                            <div class="product-cat-label">${escapeHtml(getCategoryName(p.category))}</div>
                            <div class="product-title">${escapeHtml(p.name)}</div>
                            <div class="card-rating">
