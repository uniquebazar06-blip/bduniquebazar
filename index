        async function handleAuth() {
            const mobile = document.getElementById('authMobile').value.trim();
            const password = document.getElementById('authPassword').value.trim();

            if (!/^01[3-9]\d{8}$/.test(mobile)) {
                return showToast("সঠিক ১১ ডিজিটের মোবাইল নম্বর দিন (যেমন: 017XXXXXXXX)", "error");
            }
            if (password.length < 4) {
                return showToast("কমপক্ষে ৪ অক্ষরের পাসওয়ার্ড দিন", "error");
            }

            const userRef = db.ref(`users/${mobile}`);
            try {
                const snap = await userRef.once('value');
                if (isLoginMode) {
                    if (!snap.exists()) return showToast("এই নম্বরে কোনো অ্যাকাউন্ট নেই! নিবন্ধন করুন।", "error");
                    const u = snap.val();
                    if (u.password !== password) return showToast("পাসওয়ার্ড ভুল হয়েছে!", "error");
                    completeLogin(mobile, u);
                } else {
                    if (snap.exists()) return showToast("এই নম্বরে আগে থেকেই অ্যাকাউন্ট আছে! লগইন করুন।", "error");
                    const name = document.getElementById('regName').value.trim();
                    const village = document.getElementById('regVillage').value.trim();
                    const thana = document.getElementById('regThana').value.trim();
                    const district = document.getElementById('regDistrict').value.trim();
                    if (!name || !village || !thana || !district) {
                        return showToast("নাম, গ্রাম, থানা ও জেলা সঠিকভাবে পূরণ করুন", "error");
                    }
                    const newUser = { mobile, password, name, village, thana, district, createdAt: Date.now(), favorites: {} };
                    await userRef.set(newUser);
                    completeLogin(mobile, newUser);
                    showToast("নিবন্ধন সফল হয়েছে!", "success");
                }
            } catch (e) {
                console.error(e);
                showToast("ডাটাবেইজ এরর! Firebase Rules চেক করুন।", "error");
            }
        }

