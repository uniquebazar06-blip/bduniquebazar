        async function shareCurrentProduct() {
            if (!currentProductId || !productsData[currentProductId]) return;
            const p = productsData[currentProductId];
            const base = window.location.origin !== 'null' ? `${window.location.origin}${window.location.pathname}` : window.location.href.split('?')[0];
            const shareUrl = `${base}?product=${encodeURIComponent(currentProductId)}`;
            const shareText = `${p.name} - মাত্র ৳${p.price} (BD UNIQUE BAZAR)`;

            if (navigator.share) {
                try {
                    await navigator.share({ title: p.name, text: shareText, url: shareUrl });
                    return;
                } catch (e) {}
            }
            try {
                await navigator.clipboard.writeText(`${shareText}\n${shareUrl}`);
                showToast("পণ্যের লিংক কপি হয়েছে! এখন শেয়ার করুন।", "success");
            } catch (e) {
                window.open(`https://wa.me/?text=${encodeURIComponent(shareText + ' ' + shareUrl)}`, '_blank');
            }
        }

